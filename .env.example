# Firebase Web App config: Firebase Console > Project settings > Your apps.
# NEXT_PUBLIC values must exist at build time. In Vercel, set them for the
# intended environment (Production/Preview), then redeploy after changing them.
# Missing config no longer breaks prerender; authentication remains unavailable.
NEXT_PUBLIC_FIREBASE_API_KEY = ""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN = ""
NEXT_PUBLIC_FIREBASE_PROJECT_ID = ""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET = ""
NEXT_PUBLIC_FIREBASE_APP_ID = ""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID = ""
NEXT_PUBLIC_GOOGLE_SHEET_IMAGE_ENDPOINT = ""

# Firebase Admin (server-only, jangan pakai NEXT_PUBLIC)
FIREBASE_STORAGE_BUCKET = ""
FIREBASE_DATABASE_URL = ""
FIREBASE_SERVICE_ACCOUNT_KEY_JSON = ""
FIREBASE_SERVICE_ACCOUNT_BASE64 = ""
FIREBASE_SERVICE_ACCOUNT_PATH = ""
FIREBASE_PROJECT_ID = ""
FIREBASE_CLIENT_EMAIL = ""
FIREBASE_PRIVATE_KEY = ""

